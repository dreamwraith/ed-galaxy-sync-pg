# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Code, configuration, data and documentation files
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.parquet binary
*.duckdb binary
*.db binary
*.tar.gz binary
*.whl binary
