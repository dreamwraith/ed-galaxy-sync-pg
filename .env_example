# Elite Dangerous Galaxy Sync for PostgreSQL (ed-galaxy-sync-pg)
# Copy this file to '.env' in the project root to configure default database credentials.

# PostgreSQL Connection Settings
PGHOST=localhost
PGPORT=5432
PGUSER=galaxy_updater
PGPASSWORD=your_secure_password_here
PGDATABASE=galaxy_sync

# For initial schema deployment with apply_schema:
# PGUSER=postgres
# PGPASSWORD=your_postgres_superuser_password
